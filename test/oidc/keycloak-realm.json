{
  "realm": "hemlig-test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "_comment": "TEST-ONLY realm for the Hemlig OIDC integration check (src/scripts/verify-oidc.ts). Every credential here is a throwaway value that protects nothing. Never import this into a real Keycloak.",
  "roles": {
    "realm": [
      {
        "name": "hemlig-admin",
        "description": "Hemlig administrator (ADMIN_JWT_ROLE)"
      },
      {
        "name": "hemlig-reader",
        "description": "Authenticated, but not a Hemlig administrator"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "Carries the sub claim (Keycloak 25+ keeps it in this scope)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "hemlig.admin",
      "description": "Route scope required by the Hemlig admin API (ADMIN_JWT_SCOPE)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "hemlig-test-cli",
      "name": "Hemlig test client (audience hemlig-api)",
      "description": "TEST-ONLY public client. Direct access grants (password grant) so CI can fetch real tokens headlessly. Real deployments use authorization code with PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["hemlig.admin"],
      "protocolMappers": [
        {
          "name": "hemlig-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "hemlig-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-nested",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "realm-roles-top-level",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "other-test-client",
      "name": "Other test client (audience other-api)",
      "description": "TEST-ONLY. Issues tokens whose audience is other-api, never hemlig-api, to prove the audience check.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["hemlig.admin"],
      "protocolMappers": [
        {
          "name": "other-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "other-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-nested",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "admin-user",
      "email": "admin-user@hemlig.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "test-only-admin-password",
          "temporary": false
        }
      ],
      "realmRoles": ["hemlig-admin"]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "plain-user",
      "email": "plain-user@hemlig.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Plain",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "test-only-plain-password",
          "temporary": false
        }
      ],
      "realmRoles": ["hemlig-reader"]
    }
  ]
}
