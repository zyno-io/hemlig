{
  "name": "hemlig",
  "version": "0.1.0",
  "description": "Hemlig: a Lambda, S3, DynamoDB, and KMS backed secrets delivery API for non-AWS workloads.",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./cdk": {
      "types": "./dist-cdk/cdk/index.d.ts",
      "require": "./dist-cdk/cdk/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cdk",
    "src",
    "cdk.json",
    "tsconfig.cdk.json",
    "openapi",
    "docs/**/*.md",
    "README.md",
    "PLAN.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "backfill:console-indexes": "yarn build && node dist/scripts/backfill-console-indexes.js",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:all": "yarn workspaces foreach -A --topological run build",
    "build:cdk": "yarn workspace @hemlig/console build && rm -rf dist-cdk && tsc -p tsconfig.cdk.json && cp -R packages/console/dist dist-cdk/console-dist",
    "cdk:deploy": "yarn build:cdk && cdk --app 'node dist-cdk/cdk/app.js' deploy",
    "cdk:diff": "yarn build:cdk && cdk --app 'node dist-cdk/cdk/app.js' diff",
    "cdk:synth": "yarn build:cdk && cdk --app 'node dist-cdk/cdk/app.js' synth",
    "dev:api": "yarn build && node dist/scripts/dev-ministack.js",
    "console:build": "yarn workspace @hemlig/console build",
    "dev:ui": "yarn workspace @hemlig/console dev",
    "format": "prettier --write .",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cdk.json --noEmit",
    "lint:all": "yarn build:all && yarn workspaces foreach -A --topological run lint",
    "ministack:down": "docker compose -f docker-compose.ministack.yml down -v",
    "ministack:up": "docker compose -f docker-compose.ministack.yml up -d",
    "ministack:verify": "yarn build && node dist/scripts/verify-ministack.js",
    "test": "jest --runInBand",
    "test:all": "yarn build:all && yarn workspaces foreach -A --topological run test",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.11",
    "aws-cdk": "^2.1033.0",
    "jest": "^30.0.5",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.1012.0",
    "@aws-sdk/client-dynamodb": "^3.1012.0",
    "@aws-sdk/client-iot": "^3.1116.0",
    "@aws-sdk/client-iot-data-plane": "^3.1116.0",
    "@aws-sdk/client-kms": "^3.1012.0",
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/lib-dynamodb": "^3.1012.0",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.25.10",
    "node-forge": "^1.3.1"
  },
  "resolutions": {
    "vite": "^6.4.3"
  }
}
