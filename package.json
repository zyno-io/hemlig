{
  "name": "hemlig",
  "version": "0.1.0",
  "description": "Hemlig: a serverless secrets manager in your own AWS account, backed by Lambda, S3, DynamoDB and KMS.",
  "license": "AGPL-3.0-only AND MIT",
  "packageManager": "yarn@4.10.3",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./cdk": {
      "types": "./dist-cdk/cdk/index.d.ts",
      "require": "./dist-cdk/cdk/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cdk",
    "src",
    "cdk",
    "cdk.json",
    "tsconfig.cdk.json",
    "openapi",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSING.md"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "backfill:agent-sync": "yarn build && node dist/scripts/backfill-agent-sync.js",
    "backfill:console-indexes": "yarn build && node dist/scripts/backfill-console-indexes.js",
    "backfill:secret-id-folders": "yarn build && node dist/scripts/backfill-secret-id-folders.js",
    "migrate:secret-identity": "yarn build && node dist/scripts/migrate-secret-identity.js",
    "migrate:secret-uids": "yarn build && node dist/scripts/migrate-secret-uids.js",
    "revoke:iot-for-revoked-identities": "yarn build && node dist/scripts/revoke-iot-for-revoked-identities.js",
    "reconcile:agent-grant-access": "yarn build && node dist/scripts/reconcile-agent-grant-access.js",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:all": "yarn workspaces foreach -A --topological run build",
    "build:cdk": "yarn workspace @zyno-io/hemlig-console build && rm -rf dist-cdk && tsc -p tsconfig.cdk.json && cp LICENSE dist-cdk/LICENSE && cp LICENSE-MIT dist-cdk/cdk/LICENSE && cp -R packages/console/dist dist-cdk/console-dist",
    "cdk:deploy": "yarn build:cdk && cdk --app 'node dist-cdk/cdk/app.js' deploy",
    "cdk:diff": "yarn build:cdk && cdk --app 'node dist-cdk/cdk/app.js' diff",
    "cdk:synth": "yarn build:cdk && cdk --app 'node dist-cdk/cdk/app.js' synth",
    "dev:api": "yarn build && node dist/scripts/dev-ministack.js",
    "console:build": "yarn workspace @zyno-io/hemlig-console build",
    "dev:ui": "yarn workspace @zyno-io/hemlig-console dev",
    "docs:dev": "yarn workspace @zyno-io/hemlig-docs docs:dev",
    "docs:build": "yarn workspace @zyno-io/hemlig-docs docs:build",
    "docs:preview": "yarn workspace @zyno-io/hemlig-docs docs:preview",
    "docs:lint": "yarn workspace @zyno-io/hemlig-docs docs:lint",
    "format": "prettier --write .",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cdk.json --noEmit",
    "lint:all": "yarn build:all && yarn workspaces foreach -A --topological run lint",
    "ministack:down": "docker compose -f docker-compose.ministack.yml down -v",
    "ministack:up": "docker compose -f docker-compose.ministack.yml up -d",
    "ministack:verify": "yarn build && node dist/scripts/verify-ministack.js",
    "test": "jest --runInBand",
    "verify:oidc": "yarn build && node dist/scripts/verify-oidc.js",
    "test:all": "yarn build:all && yarn workspaces foreach -A --topological run test",
    "test:watch": "jest --watch",
    "testbed:down": "cd testbed && ansible-playbook k3s/down.yml -e confirm=yes",
    "testbed:up": "cd testbed && ansible-playbook k3s/up.yml"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.11",
    "ajv": "^8",
    "aws-cdk": "^2.1033.0",
    "jest": "^30.0.5",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.8.3",
    "yaml": "^2"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewayv2": "^3.1012.0",
    "@aws-sdk/client-dynamodb": "^3.1012.0",
    "@aws-sdk/client-iot": "^3.1116.0",
    "@aws-sdk/client-iot-data-plane": "^3.1116.0",
    "@aws-sdk/client-kms": "^3.1012.0",
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/lib-dynamodb": "^3.1012.0",
    "@peculiar/asn1-csr": "2.11.1",
    "@peculiar/asn1-schema": "2.11.1",
    "@peculiar/asn1-x509": "2.11.1",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.25.10",
    "node-forge": "^1.3.1"
  },
  "resolutions": {
    "vite": "^6.4.3"
  },
  "author": "Zyno Consulting <oss@zyno.io>"
}
